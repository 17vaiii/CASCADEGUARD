# secrets — copy theft_detection/.env.example to .env locally
.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
install_log*.txt

# Node / frontend build + test output
node_modules/
theft_detection/frontend/dist/
