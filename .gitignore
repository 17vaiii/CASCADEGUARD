# Secrets — keep the committed templates, ignore local variants such as
# .env, .env.local, and .env.production at every directory level.
.env*
!.env.example
!**/.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
install_log*.txt

# Node / frontend build + test output
node_modules/
*.tsbuildinfo

# Sensor-study datasets (~350 MB, regenerate with `make study-data`).
# Everything else in data/ is committed so the app runs straight after cloning:
#   data/models/ (trained models + metrics), data/raw/baseline_states.parquet,
#   data/processed/dataset_major_only.parquet + splits.json (Replay / held-out cases)

# P2 local platform outputs (regenerate through the Makefile targets).
data/audit/
data/qdrant/
data/processed/meter_readings.parquet
data/processed/cascade_dataset.parquet
data/processed/scenario_embeddings.parquet
data/processed/throughput/
experiments/mlflow/
experiments/*.db*
experiments/mlartifacts/
mlruns/

# P4 raw simulated dataset (~80 MB; regenerate with `python -m cascadeguard.theft.pipeline`).
# Result tables in data/processed/theft/ and the trained bundle stay committable: they are the
# fallback demo data for the dashboard after a fresh clone (PRD P5-9).
data/processed/theft/dataset/
data/processed/root_gnn_dataset.parquet
*.egg-info/

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

