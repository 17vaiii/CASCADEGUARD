# OWNER: P5 | NEEDS: P2 | STATUS: ACTIVE
# Streamlit operator console. Build from the repository root:
#   docker build -f docker/Dockerfile.dashboard -t cascadeguard-dashboard .
#   docker run -p 8501:8501 cascadeguard-dashboard
# docker/Dockerfile.dashboard.dockerignore keeps the build context small. Trained models and the
# P4/P5 result tables are copied in, so the container works without running the pipelines.
FROM python:3.12-slim

WORKDIR /workspace
ENV PYTHONPATH=/workspace/src \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

COPY requirements.txt requirements-p5.txt ./
RUN pip install torch==2.14.1 --index-url https://download.pytorch.org/whl/cpu \
 && pip install -r requirements.txt -r requirements-p5.txt

COPY src ./src
COPY configs ./configs
COPY contracts ./contracts
COPY docs/results_table.md ./docs/results_table.md
COPY data ./data

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=4)"
CMD ["streamlit", "run", "src/cascadeguard/dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
