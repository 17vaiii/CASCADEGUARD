# OWNER: ALL | STATUS: ACTIVE
# CascadeGuard-Sharavathi Environment Configuration Template
# Copy this file to .env: cp .env.example .env

# General Environment
CASCADEGUARD_ENV=development
SEED=42
LOG_LEVEL=INFO

# Ray & Distributed Compute
RAY_ADDRESS=auto

# MLflow Experiment Tracking
# Local SQLite backend for direct Python runs; Compose services override with http://mlflow:5000.
MLFLOW_TRACKING_URI=sqlite:///experiments/mlflow.db

# Vector Store (pgvector / Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# API & Dashboard Ports
API_PORT=8000
DASHBOARD_PORT=8501
